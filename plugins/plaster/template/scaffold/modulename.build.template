param (
    [parameter(Position = 0)]
    [string]$BuildFile = @(Get-ChildItem 'build\*.buildenvironment.ps1')[0].FullName,
    [parameter()]
    [version]$NewVersion = $null,
    [parameter()]
    [string]$ReleaseType, # 'alpha', 'beta', 'rc'
    [parameter()]
    [string]$ReleaseNotes,
    [parameter()]
    [switch]$Force
)

class SemanticVersion : IComparable {
    [int]$Major = 0
    [int]$Minor = 0
    [int]$Patch = 0
    [int]$Revision = -1
    [string]$PrereleaseLabel = ""
    [string]$BuildLabel = ""
    [int]$PreReleaseNumber = 0

    SemanticVersion([string]$versionString = "0.0.0") {
        $this.ParseVersion($versionString)
    }

    SemanticVersion([version]$versionString = "0.0.0") {
        $this.ParseVersion($versionString)
    }

    [void] ParseVersion([string]$versionString) {
        if ($versionString -match '^(?<major>\d+)\.(?<minor>\d+)(?:\.(?<patch>\d+))?(?:\.(?<revision>\d+))?$') {
            # Simple version without prerelease or build metadata that allows for a missing patch or revision
            $this.Major = [int]$Matches.major
            $this.Minor = [int]$Matches.minor
            if ($Matches.patch) {
                $this.Patch = [int]$Matches.patch
            } else {
                $this.Patch = 0
            }
            if ($Matches.revision) {
                $this.Revision = [int]$Matches.revision
            } else {
                $this.Revision = -1
            }
        } elseif ($versionString -match '^(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)(?:\.(?<revision>\d+)|(?:-(?<prerelease>[0-9A-Za-z-\.]+)))?(?:\+(?<metadata>.+))?$') {
            $this.Major = [int]$Matches.major
            $this.Minor = [int]$Matches.minor
            $this.Patch = [int]$Matches.patch
            $this.Revision = [int]$Matches.revision
            $this.BuildLabel = $Matches.build
            if ($Matches.prerelease) {
                if ($Matches.prerelease -match '^(?<type>[a-zA-Z0-9]+?)(?:(?<number>\d+))?$') {
                    $this.PrereleaseLabel = $matches.type
                    if ($matches.number) {
                        $this.PreReleaseNumber = [int]$matches.number
                    }
                }
                elseif ($Matches.prerelease -match '^(?<type>[A-Za-z]+)(?:\.(?<number>\d+))?$') {
                    $this.PrereleaseLabel = $matches.type
                    if ($matches.number) {
                        $this.PreReleaseNumber = [int]$matches.number
                    }
                }
            }
        } else {
            throw "Invalid semantic version format: $versionString"
        }
    }

    [bool] HasPrereleaseLabel() {
        return -not [string]::IsNullOrEmpty($this.PrereleaseLabel)
    }

    [string[]] get_PrereleaseLabelIdentifiers() {
        if ($this.HasPrereleaseLabel) {
            return $this.PrereleaseLabel -split '\.'
        }
        return @()
    }

    [string] Prerelease() {
        if ($this.HasPrereleaseLabel) {
            if ($this.PreReleaseNumber -gt 0) {
                return "$($this.PrereleaseLabel)$($this.PreReleaseNumber)"
            } else {
                return $this.PrereleaseLabel
            }
        } else {
            return $null
        }
    }

    [string] Prerelease2() {
        if ($this.HasPrereleaseLabel) {
            if ($this.PreReleaseNumber -gt 0) {
                return "$($this.PrereleaseLabel).$($this.PreReleaseNumber)"
            } else {
                return $this.PrereleaseLabel
            }
        } else {
            return $null
        }
    }

    [string] ToString() {
        $ver = "$($this.Major).$($this.Minor).$($this.Patch)"
        if ($this.PrereleaseLabel) {
            $ver += "-$($this.PrereleaseLabel)"
            if ($this.PreReleaseNumber -gt 0) {
                $ver += "$($this.PreReleaseNumber)"
            }
        }
        return $ver
    }

    [string] ToString2() {
        $ver = "$($this.Major).$($this.Minor).$($this.Patch)"
        if ($this.PrereleaseLabel) {
            $ver += "-$($this.PrereleaseLabel)"
            if ($this.PreReleaseNumber -gt 0) {
                $ver += ".$($this.PreReleaseNumber)"
            }
        }
        if ($this.BuildLabel) {
            $ver += "+$($this.BuildLabel)"
        }
        return $ver
    }

    [Version] ToVersionCore() {
        return [Version]::new($this.Major, $this.Minor, $this.Patch)
    }

    [Version] ToVersion() {
        if ($this.Revision -ge 0) {
            return [Version]::new($this.Major, $this.Minor, $this.Patch, $this.Revision)
        } else {
            return [Version]::new($this.Major, $this.Minor, $this.Patch)
        }
    }

    [int] CompareTo([Object]$other) {
        if ($null -eq $other) { return 1 }
        if (-not ($other -is [SemanticVersion])) {
            throw "Cannot compare SemanticVersion to $($other.GetType().Name)"
        }

        $cmp = $this.Major.CompareTo($other.Major)
        if ($cmp -ne 0) { return $cmp }

        $cmp = $this.Minor.CompareTo($other.Minor)
        if ($cmp -ne 0) { return $cmp }

        $cmp = $this.Patch.CompareTo($other.Patch)
        if ($cmp -ne 0) { return $cmp }

        # Handle prerelease (lower is newer)
        if ($this.HasPrereleaseLabel() -and -not $other.HasPrereleaseLabel()) { return -1 }
        if (-not $this.HasPrereleaseLabel() -and $other.HasPrereleaseLabel()) { return 1 }
        if ($this.HasPrereleaseLabel() -and $other.HasPrereleaseLabel()) {
            $cmp = $this.PrereleaseLabel.CompareTo($other.PrereleaseLabel)
            if ($cmp -ne 0) { return $cmp }
            if ($this.PreReleaseNumber -ne $other.PreReleaseNumber) {
                return $this.PreReleaseNumber.CompareTo($other.PreReleaseNumber)
            }
        }

        return 0
    }

    [bool]IsGreaterThan([SemanticVersion]$other) {
        return $this.CompareTo($other) -gt 0
    }

    [bool]IsGreaterThanOrEqual([SemanticVersion]$other) {
        return $this.CompareTo($other) -ge 0
    }

    [bool]IncrementToBeGreaterThan([SemanticVersion[]]$versionList) {
        $highest = $null
        foreach ($v in $versionList) {
            if (-not $highest -or $v.CompareTo($highest) -gt 0) {
                $highest = $v
            }
        }
        if ($highest) {
            if ($this.IsGreaterThan($highest)) { return $False}
            if ($this.CompareTo($highest) -eq 0) {
                if ($this.HasPrereleaseLabel()) {
                    $this.IncrementPreReleaseNumber()
                } else {
                    $this.Patch += 1
                }
                return $True
            } # If it's already equal, no need to increment
            $this.Major = $highest.Major
            $this.Minor = $highest.Minor
            $this.Patch = $highest.Patch
            if ($this.HasPrereleaseLabel()) {
                if ($this.PrereleaseLabel -eq $highest.PrereleaseLabel) {
                    if ($this.PreReleaseNumber -le $highest.PreReleaseNumber) {
                        $this.PreReleaseNumber = $highest.PreReleaseNumber
                        $this.IncrementPreReleaseNumber()
                    }
                } else {
                    # if The current version has a prerelease label that is lower than the highest, increment the patch
                    if ((-not $highest.PrereleaseLabel) -or ($this.PrereleaseLabel.CompareTo($highest.PrereleaseLabel) -lt 0)) {
                        $this.Patch += 1
                        $this.PreReleaseNumber = 0
                    }
                }
            } elseif ($highest.HasPrereleaseLabel()) {

            } else {
                $this.Patch += 1
            }
            return $True
        }
        return $false
    }

    [bool]IncrementToBeGreaterThanOrEqual([SemanticVersion[]]$versionList) {
        $highest = $null
        foreach ($v in $versionList) {
            if (-not $highest -or $v.CompareTo($highest) -gt 0) {
                $highest = $v
            }
        }
        if ($highest) {
            if ($this.IsGreaterThanOrEqual($highest)) { return $false}
            $this.Major = $highest.Major
            $this.Minor = $highest.Minor
            $this.Patch = $highest.Patch
            if ($this.HasPrereleaseLabel()) {
                if ($this.PrereleaseLabel -eq $highest.PrereleaseLabel) {
                    if ($this.PreReleaseNumber -lt $highest.PreReleaseNumber) {
                        $this.PreReleaseNumber = $highest.PreReleaseNumber
                    }
                } else {
                    # if The current version has a prerelease label that is lower than the highest, increment the patch
                    if ((-not $highest.PrereleaseLabel) -or ($this.PrereleaseLabel.CompareTo($highest.PrereleaseLabel) -lt 0)) {
                        $this.Patch += 1
                        $this.PreReleaseNumber = 0
                    }
                }
            }
            return $True
        }
        return $false
    }

    # New: Increment Major
    [void]IncrementMajor() {
        $this.Major += 1
        $this.Minor = 0
        $this.Patch = 0
        # $this.PrereleaseLabel = ""
        $this.PreReleaseNumber = 0
    }

    # New: Increment Minor
    [void]IncrementMinor() {
        $this.Minor += 1
        $this.Patch = 0
        # $this.PrereleaseLabel = ""
        $this.PreReleaseNumber = 0
    }

    # New: Increment Patch
    [void]IncrementPatch() {
        $this.Patch += 1
        # $this.PrereleaseLabel = ""
        $this.PreReleaseNumber = 0
    }

    # New: Increment the prerelease counter, rolling over before it hits double digits.
    # PowerShell module install/update commands sort prerelease labels lexically when the
    # counter has no separator, so "rc10" sorts BELOW "rc2" and is not seen as newer than
    # the currently installed version. Capping at 9 and rolling to the next Patch on the
    # 10th iteration sidesteps that bug.
    [void]IncrementPreReleaseNumber() {
        if (($this.PreReleaseNumber + 1) -gt 9) {
            $label = $this.PrereleaseLabel
            $this.IncrementPatch()
            $this.PrereleaseLabel  = $label   # IncrementPatch preserves the label today, but be explicit
            $this.PreReleaseNumber = 1
        } else {
            $this.PreReleaseNumber += 1
        }
    }
}

Function Write-Description {
    # Basic indented descriptive build output. $Description can contain Newlines.
    [CmdletBinding()]
    Param (
        [Parameter(Mandatory=$true,Position=0)]
        [string]$color
        ,
        [Parameter(Mandatory=$false,Position=1)]
        [string]$Description = ''
        ,
        [int]$Level = 0
        ,
        [int]$indent = 1
        ,
        [switch]$accent
        ,
        [string]$AccentL = '* '
        ,
        [string]$AccentR = ''
    )

    $thisindent = (' ' * $indent) * $level
    If ($accent) {
        $accentleft = $AccentL
        $accentright = $AccentR
    } else {
        $accentleft = ''
        $accentright = ''
    }

    $Description -split '\r\n|\n' | ForEach-Object { Write-HostMessage -object "$accentleft$thisindent$($_)$accentright" -ForegroundColor $color }
}

function Write-HostMessage {
    param(
        [Parameter(Position = 0, ValueFromPipeline = $true)]
        [Alias('Message', 'Msg')]
        $Object,

        [ConsoleColor]
        $ForegroundColor,

        [ConsoleColor]
        $BackgroundColor,

        [switch]
        $NoNewLine,

        $Separator = ' ',

        [ValidateSet('Ansi', 'ConsoleColor', 'Plaintext')]
        [string]
        $RenderMode = $WriteHostMessageRenderMode
    )

    begin {
        # Custom PSHosts without UI will fail with Write-Host. Works in PS5+ due to use of InformationRecords
        $HostSupportsOutput = $null -ne $host.UI.RawUI.ForegroundColor -or $PSVersionTable.PSVersion.Major -ge 5
        if (-not $HostSupportsOutput) { return }

        # Source https://docs.microsoft.com/en-us/windows/console/console-virtual-terminal-sequences#text-formatting
        $esc = [char]27
        $ANSIcodes = @{
            ResetAll        = "$esc[0m"

            ForegroundColor = @{
                [ConsoleColor]::Black       = "$esc[30m"
                [ConsoleColor]::DarkBlue    = "$esc[34m"
                [ConsoleColor]::DarkGreen   = "$esc[32m"
                [ConsoleColor]::DarkCyan    = "$esc[36m"
                [ConsoleColor]::DarkRed     = "$esc[31m"
                [ConsoleColor]::DarkMagenta = "$esc[35m"
                [ConsoleColor]::DarkYellow  = "$esc[33m"
                [ConsoleColor]::Gray        = "$esc[37m"

                [ConsoleColor]::DarkGray    = "$esc[90m"
                [ConsoleColor]::Blue        = "$esc[94m"
                [ConsoleColor]::Green       = "$esc[92m"
                [ConsoleColor]::Cyan        = "$esc[96m"
                [ConsoleColor]::Red         = "$esc[91m"
                [ConsoleColor]::Magenta     = "$esc[95m"
                [ConsoleColor]::Yellow      = "$esc[93m"
                [ConsoleColor]::White       = "$esc[97m"
            }

            BackgroundColor = @{
                [ConsoleColor]::Black       = "$esc[40m"
                [ConsoleColor]::DarkBlue    = "$esc[44m"
                [ConsoleColor]::DarkGreen   = "$esc[42m"
                [ConsoleColor]::DarkCyan    = "$esc[46m"
                [ConsoleColor]::DarkRed     = "$esc[41m"
                [ConsoleColor]::DarkMagenta = "$esc[45m"
                [ConsoleColor]::DarkYellow  = "$esc[43m"
                [ConsoleColor]::Gray        = "$esc[47m"

                [ConsoleColor]::DarkGray    = "$esc[100m"
                [ConsoleColor]::Blue        = "$esc[104m"
                [ConsoleColor]::Green       = "$esc[102m"
                [ConsoleColor]::Cyan        = "$esc[106m"
                [ConsoleColor]::Red         = "$esc[101m"
                [ConsoleColor]::Magenta     = "$esc[105m"
                [ConsoleColor]::Yellow      = "$esc[103m"
                [ConsoleColor]::White       = "$esc[107m"
            }
        }
    }

    process {
        if (-not $HostSupportsOutput) { return }

        if ($RenderMode -eq 'Ansi') {
            $message = @(foreach ($o in $Object) { $o.ToString() }) -join $Separator
            $fg = if ($PSBoundParameters.ContainsKey('ForegroundColor')) { $ANSIcodes.ForegroundColor[$ForegroundColor] } else { '' }
            $bg = if ($PSBoundParameters.ContainsKey('BackgroundColor')) { $ANSIcodes.BackgroundColor[$BackgroundColor] } else { '' }

            # CI auto-resets ANSI on linebreak for some reason. Need to prepend style at beginning of every line
            $message = "$($message -replace '(?m)^', "$fg$bg")$($ANSIcodes.ResetAll)"

            & Write-Host -Object $message -NoNewLine:$NoNewLine
        }
        else {
            if ($RenderMode -eq 'Plaintext') {
                if ($PSBoundParameters.ContainsKey('ForegroundColor')) {
                    $null = $PSBoundParameters.Remove('ForegroundColor')
                }
                if ($PSBoundParameters.ContainsKey('BackgroundColor')) {
                    $null = $PSBoundParameters.Remove('BackgroundColor')
                }
            }

            if ($PSBoundParameters.ContainsKey('RenderMode')) {
                $null = $PSBoundParameters.Remove('RenderMode')
            }

            & Write-Host @PSBoundParameters
        }
    }
}

if ($null -ne $NewVersion) {
    [SemanticVersion]$NewVersion = $NewVersion
}

if ($null -ne $host.UI -and ($hostProperties = $host.UI.psobject.Properties) -and ($supportsVT = $hostProperties['SupportsVirtualTerminal']) -and $supportsVT.Value) {
    $script:WriteHostMessageRenderMode = 'Ansi'
}
else {
    $script:WriteHostMessageRenderMode = 'ConsoleColor'
}

function Assert-IsNonInteractiveShell {
    # Test each Arg for match of abbreviated '-NonInteractive' command.
    $NonInteractive = [Environment]::GetCommandLineArgs() | Where-Object{ $_ -like '-NonI*' }

    if ([Environment]::UserInteractive -and -not $NonInteractive) {
        # We are in an interactive shell.
        return $false
    }

    return $true
}

function Resolve-SigningCertificatePath {
    # Allow either an absolute path or one relative to BuildRoot so dev/CI can both work.
    param([string]$Path)
    if ([string]::IsNullOrWhiteSpace($Path)) { return $null }
    if ([System.IO.Path]::IsPathRooted($Path)) { return $Path }
    return Join-Path $BuildRoot $Path
}

function Get-CodeSigningCertificate {
    # Loads the PFX once per build session and caches it. Both SignModuleFiles and the
    # PublishPSGallery signing branch call this; lazy-loading avoids a password prompt
    # (or env-var read) on builds where signing is disabled.
    if ($Script:SigningCert) { return $Script:SigningCert }

    $CertPath = Resolve-SigningCertificatePath $Script:BuildEnv.SigningCertificatePath
    assert ($CertPath -and (Test-Path $CertPath)) "Signing certificate not found at '$CertPath'. Set SigningCertificatePath in the build environment or disable OptionSignModule/OptionSignNuGetPackage."

    $PwdEnvName = $Script:BuildEnv.SigningCertificatePasswordEnv
    assert (-not [string]::IsNullOrWhiteSpace($PwdEnvName)) "SigningCertificatePasswordEnv is not set."
    $PwdValue = [Environment]::GetEnvironmentVariable($PwdEnvName)
    assert (-not [string]::IsNullOrEmpty($PwdValue)) "Environment variable '$PwdEnvName' is empty. Provide the PFX password (e.g. `$env:$PwdEnvName = '...')."

    # NetworkCredential avoids the PSAvoidUsingConvertToSecureStringWithPlainText warning while
    # still producing a SecureString from the env-var-sourced password.
    $SecurePwd = ([System.Net.NetworkCredential]::new('', $PwdValue)).SecurePassword
    $flags = [System.Security.Cryptography.X509Certificates.X509KeyStorageFlags]::PersistKeySet -bor `
             [System.Security.Cryptography.X509Certificates.X509KeyStorageFlags]::Exportable
    $cert = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2 $CertPath, $SecurePwd, $flags

    # Expiry check. Run once on initial load; cache hits skip this so we don't re-warn per task.
    $now = Get-Date
    $thumbShort = if ($cert.Thumbprint.Length -ge 12) { "$($cert.Thumbprint.Substring(0,8))...$($cert.Thumbprint.Substring($cert.Thumbprint.Length - 4))" } else { $cert.Thumbprint }
    if ($cert.NotAfter -lt $now) {
        throw "Code-signing certificate expired on $($cert.NotAfter.ToString('yyyy-MM-ddTHH:mm:ss')). Subject: $($cert.Subject), Thumbprint: $thumbShort. Renew the certificate; signatures from an expired cert will not verify."
    }
    if ($cert.NotAfter -lt $now.AddDays(30)) {
        $daysLeft = [int][math]::Ceiling(($cert.NotAfter - $now).TotalDays)
        Write-Warning "Code-signing certificate expires in $daysLeft day(s) on $($cert.NotAfter.ToString('yyyy-MM-ddTHH:mm:ss')). Subject: $($cert.Subject), Thumbprint: $thumbShort. Renew the certificate before this date or future signed builds will fail verification."
    }

    $Script:SigningCert = $cert
    return $Script:SigningCert
}

function Assert-DotNetSignCapable {
    # Ensure `dotnet nuget sign` is available. Throws with actionable guidance if not.
    # Cached so repeated callers (sign + push) skip the validation after the first hit.
    if ($Script:DotNetSignChecked) { return }

    $dotnet = Get-Command dotnet -ErrorAction SilentlyContinue
    if (-not $dotnet) {
        throw "dotnet CLI not found on PATH. Install .NET SDK 6.0.300 or later from https://aka.ms/dotnet-download to sign NuGet packages."
    }

    $sdkVersion = (& dotnet --version 2>&1) -join ' '
    # `dotnet nuget sign --help` exits 0 when the verb exists, non-zero (with "Could not find a part of the path" or similar) otherwise.
    $null = & dotnet nuget sign --help 2>&1
    if ($LASTEXITCODE -ne 0) {
        throw "Installed dotnet (version $sdkVersion) does not support 'nuget sign'. Upgrade to .NET SDK 6.0.300 or later."
    }

    Write-Description Magenta "Using 'dotnet nuget' from .NET SDK $sdkVersion for signing and publishing." -Level 2
    $Script:DotNetSignChecked = $true
}

if (Test-Path $BuildFile) {
    . $BuildFile
}
else {
    throw "Without a build environment file we are at a loss as to what to do!"
}

if ($Script:BuildEnv.OptionTranscriptEnabled) {
    Write-Output 'Transcript logging: TRUE'
    $BuildToolPath = Join-Path $BuildRoot $Script:BuildEnv.BuildToolFolder
    $TranscriptLog = Join-Path $BuildToolPath $Script:BuildEnv.OptionTranscriptLogFile
    Write-Output "TranscriptLog: $($TranscriptLog)"
    Start-Transcript -Path $TranscriptLog -Append -WarningAction:SilentlyContinue
}

#$Script:BuildRoot = $BuildRoot
#region Configure
#Synopsis: Validate system requirements are met
task ValidateRequirements {
    Write-Description Magenta 'Validating System Requirements for Build' -accent
    assert ($PSVersionTable.PSVersion.Major.ToString() -eq '5') 'Powershell 5 is required for this build to function properly (you can comment this assert out if you are able to work around this requirement)'
}

# Synopsis: Run pre-build scripts (such as other builds)
task PreBuildTasks {
    Write-Description Magenta 'Running any Pre-Build scripts' -accent
    $BuildToolPath = Join-Path $BuildRoot $Script:BuildEnv.BuildToolFolder
    $PreBuildPath = Join-Path $BuildToolPath 'startup'
    # Dot source any pre build scripts.
    Get-ChildItem -Path $PreBuildPath -Recurse -Filter "*.ps1" -File | ForEach-Object {
        Write-Description Magenta "Dot sourcing pre-build script file: $($_.Name)" -level 2
        . $_.FullName
    }
}

# Synopsis: Import the current module manifest file for processing
task LoadModuleManifest {
    Write-Description Magenta 'Loading the existing module manifest for this module' -accent

    $ModuleManifestFullPath = Join-Path $BuildRoot "$($Script:BuildEnv.ModuleToBuild).psd1"
    assert (test-path $ModuleManifestFullPath) "Unable to locate the module manifest file: $ModuleManifestFullPath"
    $Script:Manifest = Test-ModuleManifest -Path $ModuleManifestFullPath
}

#Synopsis: Load required build modules using PSDepend
task LoadRequiredModules {
    Write-Description Magenta 'Loading all required modules for the build framework' -accent

    if ((Get-Module PSDepend -ListAvailable) -eq $null) {
        Write-Description Magenta "Installing PSDepend Module" -Level 2
        $null = Install-Module PSDepend -Scope:CurrentUser
    }

    $PSDependFolder = $(Join-Path $Script:BuildEnv.BuildToolFolder 'dependencies\PSDepend')
    $PSDependBuildFile = $(Join-Path $PSDependFolder 'build.depend.psd1')
    Invoke-PSDepend -Path $PSDependBuildFile -Force
    $Script:PSDependBuildModules = Invoke-PSDepend -Path $PSDependBuildFile -Test | Select-Object Version,DependencyName,DependencyType
    Invoke-PSDepend -Path $PSDependBuildFile -Import -Force
    $Script:PSDependBuildModules | ForEach-Object {
        if ($_.DependencyType -eq 'PSGalleryModule') {
            $LoadedModule = Get-Module -Name $_.DependencyName
            Write-Description Magenta "Installed version $($LoadedModule.Version) of $($_.DependencyName) from $($_.DependencyType)" -Level 2
        } else {
            Write-Description Magenta "Installed version $($_.Version) of $($_.DependencyName) from $($_.DependencyType)" -Level 2
        }
    }
}

# Synopsis: Load the module project
task LoadModule {
    Write-Description Magenta 'Attempting to load the project module.' -Accent

    $ModuleFullPath = Join-Path $BuildRoot "$($Script:BuildEnv.ModuleToBuild).psm1"
    try {
        $Script:Module = Import-Module $ModuleFullPath -Force -PassThru
    }
    catch {
        Write-Warning $_.Exception.Message
        throw "Unable to load the project module: $($ModuleFullPath)"
    }
}

# Synopsis: Validates there is no version mismatch.
task VersionCheck LoadModuleManifest, {
    Write-Description Magenta 'Validating manifest, build, and gallery module versions.' -accent

    assert ( ($Script:Manifest).Version.ToString() -eq (($Script:BuildEnv.ModuleVersion)) ) "The module manifest version ( $(($Script:Manifest).Version.ToString()) ) and release version ($($Script:BuildEnv.ModuleVersion)) are mismatched. These must be the same before continuing. Consider running the UpdateRelease task to make the module manifest version the same as the release version."
    Write-Description White 'Manifest version and the release version in the build configuration file are the same.' -Level 2
    Write-Description Magenta "Checking $($Script:BuildEnv.NugetRepository) Gallery version" -Level 2
    $GalleryVersion = Find-Module -Name ($Script:BuildEnv.ModuleToBuild) -Repository $Script:BuildEnv.NugetRepository -ErrorAction:SilentlyContinue
    if ($null -ne $GalleryVersion) {
        if ([version]$GalleryVersion.Version -gt [version]($Script:BuildEnv.ModuleVersion)) {
            throw "The current module version $($Script:BuildEnv.ModuleVersion) is less than or equal to $($GalleryVersion.Version) published in $($Script:BuildEnv.NugetRepository) Repository. You should bump up your module version to be at least greater than $($GalleryVersion.Version.ToString()) before building this module."
        }
    }
    else {
        Write-Description Magenta 'This module has not been published to the gallery so any version is ok to build at this point.' -Level 3
    }
}

#Synopsis: Validate script requirements are met, load required modules, load project manifest and module.
task Configure ValidateRequirements, PreBuildTasks, LoadRequiredModules, LoadModuleManifest, LoadModule, VersionCheck,  {
    # If we made it this far then we are configured!
    Write-Description Magenta 'Configuring build environment' -accent
}
#endregion

#region Helpers
#Synopsis: Create a CodeHealthReport of your existing code
task CodeHealthReport -if {$Script:BuildEnv.OptionCodeHealthReport} ValidateRequirements, LoadRequiredModules, {
    $BuildReportsFolder = Join-Path $BuildRoot $(Join-Path $Script:BuildEnv.BuildReportsFolder $Script:BuildEnv.ModuleVersion)
    Write-Description Magenta "Creating a prebuild code health report of your public functions to $($BuildReportsFolder)" -accent

    if (-not (Test-Path $BuildReportsFolder)) {
        [void](New-Item -Path $BuildReportsFolder -ItemType:Directory)
    }

    Write-Description Magenta 'Creating a code health report of your public functions' -level 2
    $CodeHealthScanPathPublic = Join-Path $BuildRoot $Script:BuildEnv.PublicFunctionSource
    $CodeHealthScanTestPathPublic = $CodeHealthScanPathPublic -replace  'src', 'tests\\unit'
    $CodeHealthReportPublic = Join-Path $BuildReportsFolder 'CodeHealthReport-Public.html'
    Invoke-PSCodeHealth -Path $CodeHealthScanPathPublic -HtmlReportPath $CodeHealthReportPublic -TestsPath $CodeHealthScanTestPathPublic

    if (Test-Path $CodeHealthReportPublic) {
        (Get-Content -Path $CodeHealthReportPublic -raw) -replace [regex]::escape((Resolve-Path $CodeHealthScanPathPublic)), $Script:BuildEnv.PublicFunctionSource | Out-File -FilePath $CodeHealthReportPublic -Encoding $Script:BuildEnv.Encoding -Force
    }

    Write-Description Magenta 'Creating a code health report of your private functions' -level 2
    $CodeHealthScanPathPrivate = Join-Path $BuildRoot $Script:BuildEnv.PrivateFunctionSource
    $CodeHealthScanTestPathPrivate = $CodeHealthScanPathPrivate -replace  'src', 'tests\\unit'
    $CodeHealthReportPrivate = Join-Path $BuildReportsFolder 'CodeHealthReport-Private.html'
    Invoke-PSCodeHealth -Path $CodeHealthScanPathPrivate -HtmlReportPath $CodeHealthReportPrivate -TestsPath $CodeHealthScanTestPathPrivate

    if (Test-Path $CodeHealthReportPrivate) {
        (Get-Content -Path $CodeHealthReportPrivate -raw) -replace [regex]::escape((Resolve-Path $CodeHealthScanPathPrivate)), $Script:BuildEnv.PrivateFunctionSource | Out-File -FilePath $CodeHealthReportPrivate -Encoding $Script:BuildEnv.Encoding -Force
    }
}

