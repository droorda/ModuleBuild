#         Import-Module -Name $CurrentModule

#         Write-Description Magenta "Uploading project to PSGallery: $($Script:BuildEnv.ModuleToBuild)"
#         Publish-MBTProjectToPSGallery -Name $Script:BuildEnv.ModuleToBuild -Repository $Script:BuildEnv.NugetRepository -NuGetApiKey $Script:BuildEnv.NuGetApiKey -RequiredVersion $Script:BuildEnv.ModuleVersion
