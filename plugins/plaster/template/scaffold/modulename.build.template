#region Postbuild PSGallery and Version management
# Synopsis: Run post-build scripts (such as file transformations or deployments)
task PostBuildTasks {
    Write-Description Magenta 'Running any Post-Build scripts' -accent
    $BuildToolPath = Join-Path $BuildRoot $Script:BuildEnv.BuildToolFolder
    $CleanupPath = Join-Path $BuildToolPath 'shutdown'
    # Dot source any post build cleanup scripts.
    Get-ChildItem -Path $CleanupPath -Recurse -Filter "*.ps1" -File | ForEach-Object {
        Write-Description Magenta "Dot sourcing shutdown script file: $($_.Name)" -Level 3
        . $_.FullName
    }
}

# Synopsis: Install the current built module to the local machine
task InstallModule VersionCheck, {
    Write-Description Magenta "Attempting to install the current module" -accent
    $ReleasePath = Join-Path $BuildRoot $Script:BuildEnv.BaseReleaseFolder
    $ManifestVersion = ($Script:Manifest).Version
    if ($Script:Manifest.PrivateData.PSData.Prerelease) {
        $ManifestVersion = "$ManifestVersion-$($Script:Manifest.PrivateData.PSData.Prerelease)"
    }
    $CurrentModulePath = Join-Path $ReleasePath $ManifestVersion
    assert (Test-Path $CurrentModulePath) 'The current version module has not been built yet!'

    $MyModulePath = "$((Get-MBTSpecialPath)['MyDocuments'])\WindowsPowerShell\Modules\"
    $ModuleInstallPath = "$($MyModulePath)$($Script:BuildEnv.ModuleToBuild)"
    if (Test-Path $ModuleInstallPath) {
        Write-Description Magenta "Removing installed module $($Script:BuildEnv.ModuleToBuild)" -Level 2
        if ($Force -or $Script:BuildEnv.ForceInstallModule) {
            Remove-Item -Path $ModuleInstallPath -Force -Recurse
        }
        else {
            Remove-Item -Path $ModuleInstallPath -Confirm -Recurse
        }
        assert (-not (Test-Path $ModuleInstallPath)) 'Module already installed and you opted not to remove it. Cancelling install operation!'
    }

    Write-Description Magenta "Installing current module:" -Level 2
    Write-Description Magenta "Source - $($CurrentModulePath)" -Level 3
    Write-Description Magenta "Destination - $($ModuleInstallPath)" -Level 3
    Copy-Item -Path $CurrentModulePath -Destination $ModuleInstallPath -Recurse
}

# Synopsis: Test import the current module
task TestImportInstalledModule VersionCheck, {
    Write-Description Magenta "Test importing the current module version $($Script:BuildEnv.ModuleVersion)" -accent

    $InstalledModules = @(Get-Module -ListAvailable $Script:BuildEnv.ModuleToBuild)
    assert ($InstalledModules.Count -gt 0) 'Unable to find that the module is installed!'
    if ($InstalledModules.Count -gt 1) {
        Write-Warning 'There are multiple installed modules found for this project (shown below). Be aware that this may skew the test results: '
    }
    Try {
        Import-Module -Name $Script:BuildEnv.ModuleToBuild -MinimumVersion $Script:BuildEnv.ModuleVersion -Force -ErrorAction Stop
    } Catch {
        Write-Warning ('Unable to Load Module: ' + $_.Exception.Message)
        Write-Host "Module Details:`n$($InstalledModules | Format-List Name,Path,ModuleBase,ModuleType,Version,Author,ExportedFunctions,ExportedCommands,RootModule)" -ForegroundColor Yellow
        Write-Host "Module Files`n$($InstalledModules.ModuleBase | Get-ChildItem | Format-Table | Out-String)" -ForegroundColor Yellow
    }
}

# Synopsis: Push the current release of the project to PSScriptGallery
task PublishPSGallery LoadRequiredModules, InstallModule, {
    Write-Description Magenta 'Publishing recent module release to the PowerShell Gallery' -accent
    assert ($Script:BuildEnv.NuGetApiKey) 'NuGetApiKey must be supplied to Publish Modules'

    $ReleasePath = Join-Path $BuildRoot $Script:BuildEnv.BaseReleaseFolder
    $CurrentReleasePath = Join-Path $ReleasePath $Script:BuildEnv.ModuleToBuild

    Write-Description Magenta "Publishing module to Repository:$($Script:BuildEnv.NugetRepository)" -accent

    Write-Description Magenta "OptionSignNuGetPackage = $($Script:BuildEnv.OptionSignNuGetPackage)" -Level 2
    if (-not $Script:BuildEnv.OptionSignNuGetPackage) {
        Write-Description Yellow 'OptionSignNuGetPackage is FALSE - publishing UNSIGNED nupkg via Publish-Module. Set OptionSignNuGetPackage = $true (or env var OptionSignNuGetPackage=true) to sign the package.' -Level 2
        Publish-Module -Path $CurrentReleasePath -NuGetApiKey $Script:BuildEnv.NuGetApiKey -Repository $Script:BuildEnv.NugetRepository
    }
    else {
        Write-Description Magenta 'OptionSignNuGetPackage enabled - packing locally so the .nupkg can be signed before publish.' -Level 2

        # Resolve the real feed's push location up-front so we fail fast if it isn't registered.
        $TargetRepo = Get-PSRepository -Name $Script:BuildEnv.NugetRepository -ErrorAction Stop
        $PushSource = $TargetRepo.PublishLocation
        if ([string]::IsNullOrWhiteSpace($PushSource)) { $PushSource = $TargetRepo.SourceLocation }
        assert (-not [string]::IsNullOrWhiteSpace($PushSource)) "Repository '$($Script:BuildEnv.NugetRepository)' has no PublishLocation or SourceLocation."

        # Validate `dotnet nuget sign` is available before doing any work that would need cleanup on failure.
        Assert-DotNetSignCapable

        # Load + validate cert before doing any registration so we don't leave a stale temp repo if signing config is bad.
        $null = Get-CodeSigningCertificate  # validates path + password; we sign with the file directly below
        $PfxFullPath = Resolve-SigningCertificatePath $Script:BuildEnv.SigningCertificatePath
        $PwdValue    = [Environment]::GetEnvironmentVariable($Script:BuildEnv.SigningCertificatePasswordEnv)

        $ScratchPath  = Join-Path $BuildRoot $Script:BuildEnv.ScratchFolder
        $NupkgPath    = Join-Path $ScratchPath 'nupkg'
        $LocalRepo    = $Script:BuildEnv.SigningLocalRepoName
        $null = New-Item -Path $NupkgPath -ItemType Directory -Force

        try {
            # Re-registration safety: drop any stale registration from a previous failed build.
            try { Unregister-PSRepository -Name $LocalRepo -ErrorAction Stop } catch {
                Write-Verbose "No pre-existing '$LocalRepo' repository to unregister."
            }

            Register-PSRepository -Name $LocalRepo -SourceLocation $NupkgPath -PublishLocation $NupkgPath -InstallationPolicy Trusted

            Write-Description Magenta "Packing module to local repository '$LocalRepo' at $NupkgPath" -Level 2
            Publish-Module -Path $CurrentReleasePath -Repository $LocalRepo -NuGetApiKey 'unused'

            $Nupkg = Get-ChildItem -Path $NupkgPath -Filter "$($Script:BuildEnv.ModuleToBuild).*.nupkg" -File |
                     Sort-Object LastWriteTime -Descending | Select-Object -First 1
            assert ($Nupkg) "Expected nupkg not produced in $NupkgPath"
            Write-Description Magenta "Signing $($Nupkg.Name)" -Level 2

            & dotnet nuget sign $Nupkg.FullName `
                --certificate-path $PfxFullPath `
                --certificate-password $PwdValue `
                --timestamper $Script:BuildEnv.SigningTimestampServer `
                --hash-algorithm $Script:BuildEnv.SigningHashAlgorithm `
                --timestamp-hash-algorithm $Script:BuildEnv.SigningHashAlgorithm `
                --overwrite 2>&1 | Write-Host
            assert ($LASTEXITCODE -eq 0) "dotnet nuget sign failed with exit code $LASTEXITCODE"

            Write-Description Magenta "Pushing signed package to $PushSource" -Level 2
            & dotnet nuget push $Nupkg.FullName `
                --source $PushSource `
                --api-key $Script:BuildEnv.NuGetApiKey 2>&1 | Write-Host
            assert ($LASTEXITCODE -eq 0) "dotnet nuget push failed with exit code $LASTEXITCODE"
        }
        finally {
            try { Unregister-PSRepository -Name $LocalRepo -ErrorAction Stop } catch {
                Write-Warning "Failed to unregister local repo '$LocalRepo': $($_.Exception.Message)"
            }
        }
    }

#     if (Get-Module $Script:BuildEnv.ModuleToBuild) {
#         Write-Description Magenta "This module is already installed $($Script:BuildEnv.ModuleToBuild). Removing it" -Level 2
#         Write-Verbose "$($(Get-Module $Script:BuildEnv.ModuleToBuild).Path)"
#         Get-Module $Script:BuildEnv.ModuleToBuild | ForEach-Object {
#             Remove-Module $_.Name
#         }
#     }

#     # Try to import the current module
#     $CurrentModule = Join-Path $CurrentReleasePath "$($Script:BuildEnv.ModuleToBuild).psd1"
