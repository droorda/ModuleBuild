# Synopsis: Validates that appveyor is using the next available version or higher
task DetectNewVersion LoadRequiredModules, LoadModuleManifest, {
    Write-Description Magenta 'Validating Appveyor, manifest, build, and gallery module versions.' -accent

    $SemanticVersionFilter = '^(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)(?:\.(?<revision>\d+)|(?:-(?<prerelease>[0-9A-Za-z-\.]+)))?(?:\+(?<metadata>.+))?$'
    # Manifest and BuildEnv does not have ReleaseType, so check is limited. This is hacky but works for now.

    $ManifestVersion = ($Script:Manifest).Version
    $ManifestPrerelease = $Script:Manifest.PrivateData.PSData.Prerelease
    if ($ManifestPrerelease) {
        $ManifestVersion = "$ManifestVersion-$ManifestPrerelease"
    }
    $BuildEnvModuleVersion = $Script:BuildEnv.ModuleVersion
    if ($ReleaseType) {
        $NewVersion = [SemanticVersion]::new("0.0.0-$ReleaseType")
        $BuildEnvModuleVersion = "$BuildEnvModuleVersion-$ReleaseType"
    } else {
        $NewVersion = [SemanticVersion]::new("0.0.0")
    }

    # Check for the NewVersion in the Manifest
    Write-Verbose "Checking Manifest Version: $($Script:Manifest.Version) against NewVersion: $NewVersion"

    if ($NewVersion.IncrementToBeGreaterThanOrEqual($ManifestVersion)) {
        Write-Verbose "Setting NewVersion = $NewVersion from Manifest.Version"
        $NewVersionSource = "Manifest"
    }
    # Check for the NewVersion in the BuildEnv
    Write-Verbose "Checking BuildEnv Version: $($Script:BuildEnv.ModuleVersion) against NewVersion: $NewVersion"
    if ($NewVersion.IncrementToBeGreaterThanOrEqual($BuildEnvModuleVersion)) {
        Write-Verbose "Setting NewVersion = $NewVersion from BuildEnv.ModuleVersion"
        $NewVersionSource = "BuildEnv"
    }
    # Check for latest build version in the release folder
    $ReleasePath = Join-Path $BuildRoot $Script:BuildEnv.BaseReleaseFolder
    if (Test-path -Path $ReleasePath) {
        $LatestBuilds = Get-ChildItem $ReleasePath -Directory | Where-Object {$_.Name -match '^([0-9]+(?:\.[0-9]+)+(-[A-Za-z0-9]+)?)$'}
        foreach ($LatestBuild in $LatestBuilds.Name) {
            Write-Verbose "Checking LatestBuild Version: $LatestBuild against NewVersion: $NewVersion"
            if ($NewVersion.IncrementToBeGreaterThan($LatestBuild)) {
                Write-Verbose "Setting NewVersion = $NewVersion from LatestBuild.Name"
                $NewVersionSource = "LatestBuild"
            }
        }
    }
    # Check for the LastRelease in the Nuget Repository
    $GalleryVersions = Find-Module -Name ($Script:BuildEnv.ModuleToBuild) -Repository $Script:BuildEnv.NugetRepository -AllowPrerelease -AllVersions -ErrorAction:SilentlyContinue
    foreach ($GalleryVersion in $GalleryVersions) {
        Write-Verbose "Checking Gallery Version: $($GalleryVersion.Version) against NewVersion: $NewVersion"
        Try {
            if ($NewVersion.IncrementToBeGreaterThan($GalleryVersion.Version) ) {
                Write-Verbose "Setting NewVersion = $NewVersion from GalleryVersion"
                $NewVersionSource = $Script:BuildEnv.NugetRepository
            }
        } catch {
            Write-Warning $_.Exception.Message
        }
    }
    # Check for the NewVersion in the Git tags
    $GitVersionTags = git tag -l | ForEach-Object {$_.TrimStart('v')} | Where-Object {$_ -match $SemanticVersionFilter}
    ForEach ($GitVersionTag in $GitVersionTags) {
        Write-Verbose "Checking GitTag Version: $($GitVersionTag) against NewVersion: $NewVersion"
        Try {
            if ($NewVersion.IncrementToBeGreaterThan($GitVersionTag)) {
                Write-Verbose "Setting NewVersion = $NewVersion from Git tags"
                $NewVersionSource = "Git Tags"
            }
        } catch {
            Write-Warning $_.Exception.Message
        }
    }

    # Check for the NewVersion in the Appveyor environment variable
    if (($env:APPVEYOR) -and ($NewVersion.IncrementToBeGreaterThan([version]$env:APPVEYOR_BUILD_VERSION))) {
        Write-Verbose "Setting NewVersion = $($env:APPVEYOR_BUILD_VERSION) from env:APPVEYOR_BUILD_VERSION"
        $NewVersionSource = "Appveyor"
    }

    # Bump Minor (instead of Patch) when a new public function has been added since the last published build.
    # Source-of-truth for the previous export list, in priority order:
    #   1. PSGallery / configured NuGet repo (authoritative; CI-friendly).
    #   2. Local release folder's built manifest (covers dev builds before first publish).
    # The source manifest is NOT a reliable baseline because CreateModuleManifest writes
    # FunctionsToExport only into the staged release copy, never back to the source psd1.
    # Skipped for prereleases (alpha/beta/rc), which iterate via the prerelease counter.
    if (-not $ReleaseType) {
        $PreviousFunctions = $null
        $BaselineSource = $null

        # 1. PSGallery / NuGet repo
        Try {
            $LatestGalleryStable = $GalleryVersions |
                Where-Object { -not $_.AdditionalMetadata.IsPrerelease -or $_.AdditionalMetadata.IsPrerelease -eq 'false' } |
                Sort-Object {[version]$_.Version} -Descending |
                Select-Object -First 1
            if ($LatestGalleryStable -and $LatestGalleryStable.Includes -and $LatestGalleryStable.Includes.Function) {
                $PreviousFunctions = @($LatestGalleryStable.Includes.Function)
                $BaselineSource = "$($Script:BuildEnv.NugetRepository) $($LatestGalleryStable.Version)"
            }
        } Catch {
            Write-Verbose "Gallery baseline lookup failed: $($_.Exception.Message)"
        }

        # 2. Fallback: most recent local release folder's built manifest
        if ($null -eq $PreviousFunctions) {
            $ReleasePath = Join-Path $BuildRoot $Script:BuildEnv.BaseReleaseFolder
            if (Test-Path $ReleasePath) {
                $LatestLocalBuild = Get-ChildItem $ReleasePath -Directory |
                    Where-Object { $_.Name -match '^([0-9]+(?:\.[0-9]+)+)$' } |
                    Sort-Object { [version]$_.Name } -Descending |
                    Select-Object -First 1
                if ($LatestLocalBuild) {
                    $LocalManifestPath = Join-Path $LatestLocalBuild.FullName "$($Script:BuildEnv.ModuleToBuild).psd1"
                    if (Test-Path $LocalManifestPath) {
                        Try {
                            $LocalManifestData = Import-PowerShellDataFile -Path $LocalManifestPath
                            $Funcs = $LocalManifestData.FunctionsToExport
                            if ($Funcs -and $Funcs -notcontains '*') {
                                $PreviousFunctions = @($Funcs)
                                $BaselineSource = "Local Release $($LatestLocalBuild.Name)"
                            }
                        } Catch {
                            Write-Verbose "Local release baseline read failed: $($_.Exception.Message)"
                        }
                    }
                }
            }
        }

        if ($PreviousFunctions -and $PreviousFunctions.Count -gt 0) {
            $PublicSrcPath = Join-Path $BuildRoot $Script:BuildEnv.PublicFunctionSource
            if (Test-Path $PublicSrcPath) {
                $CurrentFunctions = @()
                # alias name (old/external) -> alias target (function it forwards to)
                $CurrentAliases   = @{}

                Get-ChildItem $PublicSrcPath -Recurse -Filter "*.ps1" -File | ForEach-Object {
                    $ast = [System.Management.Automation.Language.Parser]::ParseInput((Get-Content -Path $_.FullName -Raw), [ref]$null, [ref]$null)

                    $ast.FindAll({ $args[0] -is [System.Management.Automation.Language.FunctionDefinitionAst] }, $false) | ForEach-Object {
                        $CurrentFunctions += $_.Name
                    }

                    # Parse Set-Alias / New-Alias (and their cmdlet aliases sal / nal) to capture rename mappings
                    $ast.FindAll({
                        $args[0] -is [System.Management.Automation.Language.CommandAst] -and
                        ($args[0].GetCommandName() -in @('Set-Alias','New-Alias','sal','nal'))
                    }, $false) | ForEach-Object {
                        $cmd = $_
                        $aliasName   = $null
                        $aliasTarget = $null
                        $positional  = @()
                        for ($i = 1; $i -lt $cmd.CommandElements.Count; $i++) {
                            $el = $cmd.CommandElements[$i]
                            if ($el -is [System.Management.Automation.Language.CommandParameterAst]) {
                                $pn = $el.ParameterName
                                if (($pn -like 'na*') -or ($pn -eq 'n')) {
                                    if (($i + 1) -lt $cmd.CommandElements.Count -and $cmd.CommandElements[$i + 1].Value) {
                                        $aliasName = $cmd.CommandElements[$i + 1].Value
                                        $i++
                                    }
                                } elseif (($pn -like 'val*') -or ($pn -eq 'v')) {
                                    if (($i + 1) -lt $cmd.CommandElements.Count -and $cmd.CommandElements[$i + 1].Value) {
                                        $aliasTarget = $cmd.CommandElements[$i + 1].Value
                                        $i++
                                    }
                                }
                            } elseif ($el.Value) {
                                $positional += $el.Value
                            }
                        }
                        if ($null -eq $aliasName   -and $positional.Count -ge 1) { $aliasName   = $positional[0] }
                        if ($null -eq $aliasTarget -and $positional.Count -ge 2) { $aliasTarget = $positional[1] }
                        if ($aliasName -and $aliasTarget) {
                            $CurrentAliases[$aliasName] = $aliasTarget
                        }
                    }
                }

                $AddedFunctions   = @($CurrentFunctions  | Where-Object { $PreviousFunctions -notcontains $_ })
                $RemovedFunctions = @($PreviousFunctions | Where-Object { $CurrentFunctions  -notcontains $_ })

                # Split removals: a removed function that's still reachable through an alias to a
                # current function is a backward-compatible rename, not a breaking removal.
                $BreakingRemovals = @()
                $AliasedRenames   = @()
                foreach ($removed in $RemovedFunctions) {
                    $target = $CurrentAliases[$removed]
                    if ($target -and ($CurrentFunctions -contains $target)) {
                        $AliasedRenames += "$removed -> $target"
                    } else {
                        $BreakingRemovals += $removed
                    }
                }

                # Major beats Minor: any uncovered removal is breaking.
                if ($BreakingRemovals.Count -gt 0) {
                    Write-Description Yellow "Detected $($BreakingRemovals.Count) removed public function(s) (no backward-compat alias) since $($BaselineSource): $($BreakingRemovals -join ', ')" -Level 2
                    if ($AliasedRenames.Count -gt 0) {
                        Write-Description DarkGray "Backward-compat aliased renames: $($AliasedRenames -join '; ')" -Level 3
                    }
                    if ($AddedFunctions.Count -gt 0) {
                        Write-Description DarkGray "Also detected $($AddedFunctions.Count) added: $($AddedFunctions -join ', ')" -Level 3
                    }
                    if ($NewVersion.Major -eq 0) {
                        Write-Description Yellow "Major version suggested (semver: breaking change - removed functionality) Automatically Bumping from Version 0 Blocked" -Level 2
                    } else {
                        Write-Description Yellow "Bumping Major version (semver: breaking change - removed functionality)" -Level 2
                        $NewVersion.IncrementMajor()
                        $NewVersionSource = "Removed Public Function (Major bump from $BaselineSource)"
                    }
                }
                elseif ($AddedFunctions.Count -gt 0) {
                    Write-Description Cyan "Detected $($AddedFunctions.Count) new public function(s) since $($BaselineSource): $($AddedFunctions -join ', ')" -Level 2
                    if ($AliasedRenames.Count -gt 0) {
                        Write-Description Cyan "Including aliased renames: $($AliasedRenames -join '; ')" -Level 3
                    }
                    Write-Description Cyan "Bumping Minor version (semver: added functionality)" -Level 2
                    $NewVersion.IncrementMinor()
                    $NewVersionSource = "New Public Function (Minor bump from $BaselineSource)"
                }
                elseif ($AliasedRenames.Count -gt 0) {
                    # Pure rename: only the names changed, the surface area is otherwise unchanged.
                    # New canonical names ARE additions, so still a Minor bump.
                    Write-Description Cyan "Detected $($AliasedRenames.Count) aliased rename(s) since $($BaselineSource): $($AliasedRenames -join '; ')" -Level 2
                    Write-Description Cyan "Bumping Minor version (semver: added functionality - new canonical name)" -Level 2
                    $NewVersion.IncrementMinor()
                    $NewVersionSource = "Aliased Rename (Minor bump from $BaselineSource)"
                }
            }
        } else {
            Write-Verbose "No baseline found (gallery / local release) - skipping new-function detection."
        }
    }

    do {
        $UpdateAppveyorBuildError = $False
        if (($env:APPVEYOR) -and ($NewVersion -ne [version]$env:APPVEYOR_BUILD_VERSION)) {
            Write-Description Magenta 'Updating Appveyor Version' -Level 2
            Try {
                Update-AppveyorBuild -Version $NewVersion -ErrorAction Stop
            } catch {
                if ($_.Exception.InnerException.message -eq 'Build with specified version already exists.') {
                    Write-Description Yellow "Appveyor Revsion colision for $NewVersion, Incrementing Revision" -Level 3
                    $UpdateAppveyorBuildError = $True
                    [String[]]$NewVersion = $NewVersion.tostring().Split(".")
                    if ($NewVersion[3]) {$NewVersion[3] = [int]$NewVersion[3] + 1} else {$NewVersion += 0} # Increment Revision by 1
                    $NewVersion[3] = [math]::max([int]$env:APPVEYOR_BUILD_NUMBER,$NewVersion[3]) # ensure Revision is at least the build count
                    [Version]$NewVersion = $NewVersion -join '.'
                } else {
                    Throw $_
                }
            }
        }
    } while ($UpdateAppveyorBuildError)

    if ($NewVersion -ne ($Script:Manifest).Version) {
        Write-Description Magenta 'Updating Manifest version' -Level 2
        $ModuleManifestFullPath = Join-Path $BuildRoot "$($Script:BuildEnv.ModuleToBuild).psd1"
        Write-Verbose "Updating module manifest with new module version: $($NewVersion.ToVersionCore()) and prerelease label: $($NewVersion.Prerelease())"
        if ($NewVersion.PrereleaseLabel) {
            Update-ModuleManifest -Path $ModuleManifestFullPath -ModuleVersion $NewVersion.ToVersionCore() -Prerelease $NewVersion.Prerelease()
        } else {
            Update-ModuleManifest -Path $ModuleManifestFullPath -ModuleVersion $NewVersion.ToVersion() -Prerelease "`r" # Stupid fix to get rid of the Prerelease label in the manifest
        }
        $Script:Manifest = Test-ModuleManifest -Path $ModuleManifestFullPath
    }
    if ($NewVersion -ne $Script:BuildEnv.ModuleVersion) {
        Write-Description Magenta 'Updating module version in the build configuration file' -Level 2
        [String]$Script:BuildEnv.ModuleVersion = $NewVersion.ToVersionCore()
        Save-BuildData
    }
    Write-Description Magenta "Module Version is $NewVersion provided from $NewVersionSource" -Level 2
    # [SemanticVersion]$script:NewVersion = $NewVersion
    $env:ModuleVersion = $NewVersion
}

# Synopsis: Set a new version of the module
task NewVersion LoadRequiredModules, LoadModuleManifest, {
    Write-Description Magenta 'Updating module build version' -accent
    $ModuleManifestFullPath = Join-Path $BuildRoot "$($Script:BuildEnv.ModuleToBuild).psd1"
    $ReleasePath = Join-Path $BuildRoot $Script:BuildEnv.BaseReleaseFolder
    if (Test-path -Path $ReleasePath) {
        $AllReleases = @(Get-ChildItem $ReleasePath -Directory | Where-Object {$_.Name -match '^([0-9]+(?:\.[0-9]+)+)$'} | ForEach-Object {[version]$_.Name})
    }
    # if a new version wasn't passed as a parameter then prompt for one
    if ($null -eq $NewVersion) {
        do {
            $NewVersion = Read-Host -Prompt 'Enter the version (ie 0.0.8) for your build release'
            if ([string]::IsNullOrEmpty($NewVersion)) {
                Write-Description Red "You need to enter a valid module version (ie. 1.2.0)" -level 2
            }
        } while ( [string]::IsNullOrEmpty($NewVersion) -and ($NewVersion -notmatch '\d+\.\d+\.\d+') )
    }
    if ($AllReleases -contains $NewVersion) {
        if ((-not $Force) -and (-not $Script:BuildEnv.Force)) {
            throw 'The module version already has been released (the folder exists within the releases folder. In order to set your build project to this version you will need to pass the -Force switch to this build script with the -NewVersion parameter'
        }
    }

    $Script:BuildEnv.ModuleVersion = $NewVersion.ToString()

    Write-Description Magenta 'Saving persistent build file with new module version' -level 2
    Save-BuildData

    Write-Description Magenta 'Updating module manifest with new module version' -level 2
    try {
        Update-ModuleManifest -Path $ModuleManifestFullPath -ModuleVersion $NewVersion.toVersion()
    }
    catch {
        throw $_
    }
}

# Synopsis: Update current module manifest with the version defined in the build config file (if they differ)
task UpdateRelease NewVersion, LoadRequiredModules, LoadModuleManifest, {
    Write-Description Magenta 'Updating the release notes of this module' -accent

    $ModuleManifestFullPath = Join-Path $BuildRoot "$($Script:BuildEnv.ModuleToBuild).psd1"
    # If there is a version mismatch then we need to put in some release notes and update the module manifest
    if ($null -eq $ReleaseNotes) {
        do {
            $ReleaseNotes = Read-Host -Prompt 'Enter brief release notes for this new version'
            if ([string]::IsNullOrEmpty($ReleaseNotes)) {
                Write-Description Red "You need to enter some kind of notes for your new release to update the manifest with!" -level 2
            }
        } while ([string]::IsNullOrEmpty($ReleaseNotes))
    }

    try {
        Update-ModuleManifest -Path $ModuleManifestFullPath -ReleaseNotes $ReleaseNotes
    }
    catch {
        throw $_
    }
}

# Synopsis: Update the current build patch version
task AutoIncreaseVersionBuildLevel -after PublishPSGallery -if {$Script:BuildEnv.OptionUpdateVersionAfterPublishing} {
    Write-Description Magenta 'Attempting to update the module build version' -accent

    $ModuleManifestFullPath = Join-Path $BuildRoot "$($Script:BuildEnv.ModuleToBuild).psd1"
    $ReleasePath = Join-Path $BuildRoot $Script:BuildEnv.BaseReleaseFolder
    $AllReleases =  @(Get-ChildItem $ReleasePath -Directory | Where-Object {$_.Name -match '^([0-9]+(?:\.[0-9]+)+)$'} | ForEach-Object {[version]$_.Name})
    $NewestRelease = $AllReleases | Sort-Object -Descending | Select-Object -First 1
    $ProposedNewRelease = "$($NewestRelease.Major).$($NewestRelease.Minor)"
    if ($NewestRelease.Build) {$ProposedNewRelease += ".$($NewestRelease.Build + 1)"} else {$ProposedNewRelease += '.0'}
    if ($NewestRelease.Revision) {$ProposedNewRelease += ".$($NewestRelease.Revision + 1)"}
    $ProposedNewRelease = [version]$ProposedNewRelease

    $Script:BuildEnv.ModuleVersion = $ProposedNewRelease.ToString()

    Write-Description Magenta 'Saving persistent build file with new module version' -level 2
    Save-BuildData

    $NewReleaseNotes = "$($ProposedNewRelease.ToString()) release"

    Write-Description Magenta 'Updating module manifest with new module version' -level 2
    try {
        Update-ModuleManifest -Path $ModuleManifestFullPath -ModuleVersion $ProposedNewRelease -ReleaseNotes $NewReleaseNotes
    }
    catch {
        throw $_
    }

    Write-Description Green "Module build version has been updated to $($ProposedNewRelease.ToString())" -level 2
}

# Synopsis: Push to github
task GithubPushVersionRelease VersionCheck, {

    Write-Description Magenta "Attempting to Push Git Changes" -accent
    $ManifestVersion = ($Script:Manifest).Version
    if ($Script:Manifest.PrivateData.PSData.Prerelease) {
        $ManifestVersion = "$ManifestVersion-$($Script:Manifest.PrivateData.PSData.Prerelease)"
    }

    exec { git fetch } | Write-Verbose
    $changes = exec { git status --short }
    Write-Description Magenta "$($changes.count) Git Changes" -Level 3
    $Manifestchanges = $changes | Where-Object {$_ -match '\.psd1'}
    if ($Manifestchanges -and (-not [string]::IsNullOrEmpty($Script:Manifest.PrivateData.PSData.Prerelease))) {
        Write-Description Yellow "Stashing manifest change $change for prerelease version $ManifestVersion" -Level 2
        exec { git stash push -m "StashDuringBuild" -- $(($Manifestchanges | ForEach-Object {$_.trim().split(' ',2)[1]}) -join ' ') }
        $changes = exec { git status --short }
    }
    if ([String]::IsNullOrEmpty($changes)) {
        Write-Description Green "No changes to commit for version $ManifestVersion" -Level 2
    } else {
        Write-Description DarkGray ($changes | Out-String) -level 2
        exec { git add . }
        if (-not [string]::IsNullOrEmpty($ReleaseNotes)) {
            exec { git commit -m "$ReleaseNotes" }
        }
        else {
            exec { git commit -m "Build $ManifestVersion" }
        }
    }

    Write-Verbose "git tag -a `"v$ManifestVersion`" -m `"v$ManifestVersion`""
    exec { git tag -a "v$ManifestVersion" -m "v$ManifestVersion" }
    Write-Verbose "git push --follow-tags --quiet"
    exec { git push --follow-tags --quiet }

    $changes = exec { git status --short }
    assert (-not $changes) "Please, commit changes.`n$changes"

    if (git stash list | Where-Object {$_ -match 'StashDuringBuild'}) {
        Write-Description Yellow "Applying stashed manifest changes for prerelease version $ManifestVersion" -Level 2
        exec { git stash pop | Out-Null }
    }
}

# Synopsis: Push to github
task GithubPush VersionCheck, {
    exec { git add . }
    if ($ReleaseNotes -ne $null) {
        exec { git commit -m "$ReleaseNotes"}
    }
    else {
        exec { git commit -m "$($Script:BuildEnv.ModuleVersion)" }
    }
    exec { git push origin master }
    $changes = exec { git status --short }
    assert (-not $changes) "Please, commit changes."
}

# Synopsis: Push with a version tag.
task GitPushRelease VersionCheck, {
    $changes = exec { git status --short }
    assert (-not $changes) "Please, commit changes.`n$changes"

    exec { git push }
    exec { git tag -a "v$($Script:BuildEnv.ModuleVersion)" -m "v$($Script:BuildEnv.ModuleVersion)" }
    exec { git push origin "v$($Script:BuildEnv.ModuleVersion)" }
}
