# Synopsis:  Collect a list of our public methods for later module manifest updates
task GetPublicFunctions {
    Write-Description Magenta 'Parsing for public (exported) function names' -accent
    $ExportedFunction = @()
    $ExportedAlias = @()
    Get-ChildItem (Join-Path $BuildRoot $Script:BuildEnv.PublicFunctionSource) -Recurse -Filter "*.ps1" -File | Sort-Object Name | ForEach-Object {
        $ast = [System.Management.Automation.Language.Parser]::ParseInput((Get-Content -Path $_.FullName -Raw), [ref]$null, [ref]$null)
        $ast.FindAll({ $args[0] -is [System.Management.Automation.Language.FunctionDefinitionAst] }, $false) | ForEach-Object {
            $ExportedFunction += $_.Name
        }


        $ast.FindAll(
            {
                $args[0] -is [System.Management.Automation.Language.CommandAst] -and
                ($args[0].GetCommandName() -eq "Set-Alias" -or $args[0].GetCommandName() -eq "New-Alias")
            },
            $false
        ) | ForEach-Object {
            $commandElements = $_.CommandElements
            if ($commandElements.Count -ge 3) {
                $ExportedAlias += $commandElements[2].Value  # Second parameter is the target
            }
        }
    }

    if ($ExportedFunction.Count -eq 0) {
        Write-Error 'There are no public functions to export!'
    }
    $Script:FunctionsToExport = $ExportedFunction
    Write-Description Magenta "Number of exported functions found = $($ExportedFunction.Count)" -Level 2
    $Script:AliasesToExport = $ExportedAlias
    Write-Description Magenta "Number of exported aliases found = $($ExportedAlias.Count)" -Level 2
}

# Synopsis: Validate that sensitive strings are not found in your code
task SanitizeCode -if {$Script:BuildEnv.OptionSanitizeSensitiveTerms} {
    Write-Description Magenta 'Attempting to find sensitive terms in the code' -accent
    $ScratchPath = Join-Path $BuildRoot $Script:BuildEnv.ScratchFolder
    $StageReleasePath = Join-Path $ScratchPath $Script:BuildEnv.BaseReleaseFolder

    ForEach ($Term in $Script:BuildEnv.OptionSensitiveTerms) {
        Write-Description Magenta "Checking Files for sensitive string: $Term" -level 2
        $TermsFound = Get-ChildItem -Path $ScratchPath -Recurse -File | Where-Object {$_.FullName -notlike "$($StageReleasePath)*"} | Select-String -Pattern $Term
        if ($TermsFound.Count -gt 0) {
            Write-Description Magenta "Sensitive string found in the following files:" -Level 3
            $TermsFound | ForEach-Object {
                Write-Description yellow $_ -level 4
            }
            throw "Sensitive Terms found!"
        }
    }
}

